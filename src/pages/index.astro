---
/*
 *  -----------------------------------------------------  *
 *  -----  index.astro  --  /src/pages/index.astro  -----  *
 *  -----------------------------------------------------  *
 */

import Layout from "@/src/layouts/Layout.astro";

/** - `sesión publicada por el middleware en esta request` */
const { isLoggedIn, user } = Astro.locals;

/** - `nombre visible de la persona autenticada` */
const displayName = user?.name || user?.email || "";
---

<Layout>
    <!-- -----  presentación del proyecto  -----  -->
    <section class="rounded-3xl bg-gradient-to-br from-green-50 via-white to-white p-8 ring-1 ring-green-100 sm:p-10">
        <!-- -----  título y estado de la sesión  -----  -->
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <h1 class="max-w-xl text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
                Autenticación con Astro y Firebase
            </h1>

            <span class="inline-flex shrink-0 items-center gap-2 self-start rounded-full bg-white px-3 py-1 text-xs font-semibold text-gray-700 ring-1 ring-gray-200">
                <span
                    class:list={[
                        "h-2 w-2 rounded-full",
                        isLoggedIn ? "bg-green-600" : "bg-gray-400",
                    ]}
                    aria-hidden="true"
                ></span>
                {isLoggedIn ? "Sesión activa" : "Sin sesión"}
            </span>
        </div>

        <p class="mt-4 max-w-2xl text-base leading-7 text-gray-600">
            Un proyecto de práctica que recorre el ciclo completo de la
            autenticación: registro con verificación por correo, ingreso con
            email o Google, sesión compartida entre cliente y servidor, y rutas
            que solo pueden ver las personas autenticadas.
        </p>

        <!--  -----  si hay sesión, saludar a la persona autenticada  -----  -->
        {isLoggedIn && displayName && (
            <p class="mt-3 text-sm text-gray-600">
                Sesión iniciada como{" "}
                <span class="font-semibold text-gray-900">{displayName}</span>.
            </p>
        )}

        <!-- -----  acciones principales  -----  -->
        <div class="mt-6 flex flex-wrap gap-3">
            <a
                href={isLoggedIn ? "/protected" : "/login"}
                class="inline-flex items-center justify-center rounded-full bg-green-700 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-green-700/20 transition-colors hover:bg-green-800 focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 focus-visible:outline-none"
            >
                {isLoggedIn ? "Ir a la página protegida" : "Ingresar"}
            </a>

            <!--  -----  si no hay sesión, ofrecer el registro  -----  -->
            {!isLoggedIn && (
                <a
                    href="/register"
                    class="inline-flex items-center justify-center rounded-full border border-gray-300 bg-white px-6 py-3 text-sm font-semibold text-gray-700 transition-colors hover:border-green-300 hover:text-green-800 focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 focus-visible:outline-none"
                >
                    Crear cuenta
                </a>
            )}
        </div>
    </section>

    <!-- -----  funcionalidades de autenticación  -----  -->
    <section class="mt-10">
        <h2 class="text-xl font-semibold text-gray-900">Qué incluye</h2>

        <ul class="mt-4 divide-y divide-gray-100 overflow-hidden rounded-2xl border border-gray-200 bg-white">
            <li class="flex gap-4 p-5">
                <!--  -----  icono de verificación  -----  -->
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="mt-0.5 h-5 w-5 shrink-0 text-green-700"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M4.5 12.75l6 6 9-13.5"
                    />
                </svg>

                <div>
                    <h3 class="font-semibold text-gray-900">
                        Registro con email y contraseña
                    </h3>
                    <p class="mt-1 text-sm leading-6 text-gray-600">
                        Validación con Zod, creación del perfil en Firebase y
                        envío del correo de verificación.
                    </p>
                </div>
            </li>

            <li class="flex gap-4 p-5">
                <!--  -----  icono de verificación  -----  -->
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="mt-0.5 h-5 w-5 shrink-0 text-green-700"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M4.5 12.75l6 6 9-13.5"
                    />
                </svg>

                <div>
                    <h3 class="font-semibold text-gray-900">
                        Ingreso con email o Google
                    </h3>
                    <p class="mt-1 text-sm leading-6 text-gray-600">
                        Popup de Google, idToken validado en el servidor y
                        sesión sincronizada con Firebase.
                    </p>
                </div>
            </li>

            <li class="flex gap-4 p-5">
                <!--  -----  icono de verificación  -----  -->
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="mt-0.5 h-5 w-5 shrink-0 text-green-700"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M4.5 12.75l6 6 9-13.5"
                    />
                </svg>

                <div>
                    <h3 class="font-semibold text-gray-900">
                        Rutas protegidas por middleware
                    </h3>
                    <p class="mt-1 text-sm leading-6 text-gray-600">
                        Si no hay sesión, el middleware redirige a{" "}
                        <code class="whitespace-nowrap font-mono text-[13px] font-medium text-green-800">
                            /login
                        </code>
                        ; la página protegida solo muestra contenido
                        autenticado.
                    </p>
                </div>
            </li>

            <li class="flex gap-4 p-5">
                <!--  -----  icono de verificación  -----  -->
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="mt-0.5 h-5 w-5 shrink-0 text-green-700"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M4.5 12.75l6 6 9-13.5"
                    />
                </svg>

                <div>
                    <h3 class="font-semibold text-gray-900">
                        Sesión compartida y logout
                    </h3>
                    <p class="mt-1 text-sm leading-6 text-gray-600">
                        El middleware publica{" "}
                        <code class="whitespace-nowrap font-mono text-[13px] font-medium text-green-800">
                            isLoggedIn
                        </code>{" "}
                        y{" "}
                        <code class="whitespace-nowrap font-mono text-[13px] font-medium text-green-800">
                            user
                        </code>{" "}
                        en Astro.locals; el cierre de sesión también pasa por
                        una Astro Action.
                    </p>
                </div>
            </li>
        </ul>
    </section>

    <!-- -----  flujo de la sesión  -----  -->
    <section class="mt-10">
        <h2 class="text-xl font-semibold text-gray-900">
            Cómo viaja la sesión
        </h2>

        <ol class="mt-4 grid gap-4 sm:grid-cols-2">
            <li class="flex min-w-0 gap-3">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-green-100 text-sm font-bold text-green-800">
                    1
                </span>
                <p class="min-w-0 break-words text-sm leading-6 text-gray-600">
                    El formulario llama a una Astro Action:{" "}
                    <code class="whitespace-nowrap font-mono text-[13px] font-medium text-green-800">
                        loginUser
                    </code>
                    ,{" "}
                    <code class="whitespace-nowrap font-mono text-[13px] font-medium text-green-800">
                        registerUser
                    </code>{" "}
                    o{" "}
                    <code class="whitespace-nowrap font-mono text-[13px] font-medium text-green-800">
                        loginGoogle
                    </code>
                    .
                </p>
            </li>

            <li class="flex min-w-0 gap-3">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-green-100 text-sm font-bold text-green-800">
                    2
                </span>
                <p class="min-w-0 break-words text-sm leading-6 text-gray-600">
                    La acción valida el input con Zod y ejecuta la operación
                    correspondiente en Firebase.
                </p>
            </li>

            <li class="flex min-w-0 gap-3">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-green-100 text-sm font-bold text-green-800">
                    3
                </span>
                <p class="min-w-0 break-words text-sm leading-6 text-gray-600">
                    En cada request, el middleware lee la sesión y publica{" "}
                    <code class="whitespace-nowrap font-mono text-[13px] font-medium text-green-800">
                        isLoggedIn
                    </code>{" "}
                    y{" "}
                    <code class="whitespace-nowrap font-mono text-[13px] font-medium text-green-800">
                        user
                    </code>{" "}
                    en Astro.locals.
                </p>
            </li>

            <li class="flex min-w-0 gap-3">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-green-100 text-sm font-bold text-green-800">
                    4
                </span>
                <p class="min-w-0 break-words text-sm leading-6 text-gray-600">
                    Las rutas privadas consultan esa sesión; si no existe,
                    redirigen a /login antes de renderizar contenido.
                </p>
            </li>
        </ol>
    </section>

    <!-- -----  tecnologías del proyecto  -----  -->
    <p class="mt-10 border-t border-gray-200 pt-5 text-sm text-gray-600">
        Construido con{" "}
        <a
            href="https://docs.astro.build/en/guides/actions/"
            target="_blank"
            rel="noreferrer"
            class="font-medium text-green-800 underline underline-offset-4 hover:text-green-900"
        >
            Astro Actions
        </a>
        ,{" "}
        <a
            href="https://firebase.google.com/docs/auth"
            target="_blank"
            rel="noreferrer"
            class="font-medium text-green-800 underline underline-offset-4 hover:text-green-900"
        >
            Firebase Authentication
        </a>{" "}
        y Tailwind CSS.
    </p>
</Layout>
