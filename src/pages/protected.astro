---

/*
    *  -------------------------------------------------------------  *
    *  -----  protected.astro  --  /src/pages/protected.astro  -----  *
    *  -------------------------------------------------------------  *
 */

import Layout from "@/src/layouts/Layout.astro";
import { firebase } from "@/src/firebase/config";


/**
 * --------------------------------------
 * -----  type  -  `SessionSource`  -----
 * --------------------------------------
 * - `fuente de la sesión que pinta esta página`
 */
type SessionSource = "locals" | "firebase";



/**
 * --------------------------------------------
 * -----  interface  -  `SessionProfile`  -----
 * --------------------------------------------
 * - `datos que consume la tarjeta, venga de donde venga`
 */
interface SessionProfile {

    /** - `nombre visible` */
    name: string;

    /** - `correo` */
    email: string;

    /** - `si el correo ya fue verificado` */
    emailVerified: boolean;

    /** - `url del avatar, o null si no hay foto` */
    avatarUrl: string | null;
}



/**
 * --------------------------------
 * -----  `loadFromLocals()`  -----
 * --------------------------------
 * - arma el perfil desde Astro.locals
 */
const loadFromLocals = (): SessionProfile | null => {

    /** - `sesión publicada por el middleware` */
    const { isLoggedIn, user } = Astro.locals;

    //  -----  si no hay sesión, no hay perfil  -----
    if (!isLoggedIn || !user)
        //  -----  indicar que no hay usuario  -----
        return null;

    //  -----  devolver el perfil de locals  -----
    return {
        name: user.name || "No display Name",
        email: user.email,
        emailVerified: user.emailVerified,
        avatarUrl: user.avatar || null,
    };

};



/**
 * ----------------------------------
 * -----  `loadFromFirebase()`  -----
 * ----------------------------------
 * - arma el perfil desde el usuario de Firebase
 */
const loadFromFirebase = async (): Promise<SessionProfile | null> => {

    /** - `usuario autenticado en Firebase` */
    const firebaseUser = firebase.auth.currentUser;

    //  -----  si no hay usuario, no hay perfil  -----
    if (!firebaseUser)
        //  -----  indicar que no hay usuario  -----
        return null;

    //  -----  recargar el usuario autenticado  -----
    await firebaseUser.reload();

    /** - `datos del perfil en Firebase` */
    const { displayName, email, emailVerified, photoURL, providerData } =
        firebaseUser;

    /** - `foto del proveedor cuando el perfil no tiene photoURL` */
    const providerPhoto = providerData.find(
        (provider) => provider.photoURL,
    )?.photoURL;

    //  -----  devolver el perfil de Firebase  -----
    return {
        name: displayName ?? "No display Name",
        email: email ?? "",
        emailVerified,
        avatarUrl: photoURL ?? providerPhoto ?? null,
    };

};



/** - `fuente por defecto cuando la url no pide otra` */
const defaultSessionSource: SessionSource = "firebase";

/** - `fuente pedida en la query source` */
const requestedSource = Astro.url.searchParams.get("source");

/** - `fuente activa de la sesión` */
const sessionSource: SessionSource =
    requestedSource === "firebase" || requestedSource === "locals"
        ? requestedSource
        : defaultSessionSource;

/** - `perfil de la fuente elegida` */
let profile: SessionProfile | null;

//  -----  si la fuente es locals, leer Astro.locals  -----
if (sessionSource === "locals")
    //  -----  cargar el perfil de locals  -----
    profile = loadFromLocals();
//  -----  si la fuente es firebase, leer currentUser  -----
else
    //  -----  cargar el perfil de Firebase  -----
    profile = await loadFromFirebase();

//  -----  si no hay perfil, salir al login  -----
if (!profile)
    //  -----  redirigir al login  -----
    return Astro.redirect("/login");

/** - `datos que pinta la tarjeta` */
const { name, email, emailVerified, avatarUrl } = profile;

---

<Layout>
    <header class="bg-gray-800 text-white mb-4 p-4">
        <h1 class="text-3xl text-center">Página Protegida</h1>
    </header>

    <!-- component -->
    <div class="bg-gray-200 rounded-xl font-sans h-[500px] w-full flex flex-row justify-center items-center">
        <!--  -----  card del usuario  -----  -->
        <div class="card w-96 mx-auto bg-white shadow-xl hover:shadow rounded-3xl">
            {avatarUrl ? (
                <img
                    class="w-32 h-32 mx-auto rounded-full -mt-20 border-8 border-white object-cover"
                    src={avatarUrl}
                    alt={`Avatar de ${name}`}
                    referrerpolicy="no-referrer"
                />
            ) : (
                <div class="w-32 h-32 mx-auto rounded-full -mt-20 border-8 border-white bg-gray-300 flex justify-center items-center">
                    <span class="text-white text-3xl font-extrabold">
                        {name.substring(0, 2)}
                    </span>
                </div>
            )}

            <div class="text-center mt-2 text-3xl font-medium">{name}</div>
            <div class="text-center mt-2 font-light text-sm">{email}</div>
            <div class="text-center font-normal text-lg">
                {emailVerified ? "Email Verificado" : "No verificado"}
            </div>
            <div class="px-6 text-center mt-2 font-light text-sm">
                <p>
                    Front end Developer, avid reader. Love to take a long walk,
                    swim
                </p>
            </div>
            <hr class="mt-8" />
            <div class="flex p-4">
                <div class="w-1/2 text-center">
                    <span class="font-bold">1.8 k</span> Followers
                </div>
                <div class="w-0 border border-gray-300"></div>
                <div class="w-1/2 text-center">
                    <span class="font-bold">2.0 k</span> Following
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-gray-800 text-white mt-4 p-4">
        <p class="text-center text-white">
            Esta página es protegida y solo puede ser accedida por usuarios
            autenticados.
        </p>
        <p class="text-center text-white">
            {sessionSource === "locals"
                ? "Sesión leída desde Astro.locals"
                : "Sesión leída desde Firebase"}
        </p>
    </footer>
</Layout>
