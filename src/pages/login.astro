---

/*
    *  -----------------------------------------------------  *
    *  -----  login.astro  --  /src/pages/login.astro  -----  *
    *  -----------------------------------------------------  *
 */

import "@/src/styles/global.css";
import AuthLayout from "@/src/layouts/AuthLayout.astro";


/** - `valor de la cookie 'email'` */
const email = Astro.cookies.get("email")?.value ?? "";

/** - `true si la cookie de email tiene valor` */
const rememberMe = !!email;

---

<AuthLayout
    title="Login"
    titleAuth="Login"
    descriptionAuth="Please sign in to your account."
>
    <div class="flex w-full max-w-md justify-center self-center z-10">
        <!-- -----  Formulario de Login  ----- -->
        <form method="post" class="w-full rounded-2xl bg-white p-6 sm:p-12">
            <header class="mb-4">
                <h3 class="font-semibold text-2xl text-gray-800">Login</h3>
                <p class="text-gray-500">Please sign in to your account.</p>
            </header>

            <!-- -----  Contenido del formulario  ----- -->
            <div class="space-y-5">
                <!-- -----  Campo de email  ----- -->
                <div class="space-y-2">
                    <label
                        for="email"
                        class="text-sm font-medium text-gray-700 tracking-wide"
                    >
                        Email
                    </label>

                    <input
                        id="email"
                        name="email"
                        class="w-full text-base px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-green-400"
                        type="email"
                        autocomplete="email"
                        placeholder="mail@gmail.com"
                        value={email}
                    />
                </div>

                <!-- -----  Campo de contraseña  ----- -->
                <div class="space-y-2">
                    <label
                        for="password"
                        class="mb-5 text-sm font-medium text-gray-700 tracking-wide"
                    >
                        Password
                    </label>

                    <input
                        id="password"
                        name="password"
                        class="w-full content-center text-base px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-green-400"
                        type="password"
                        autocomplete="current-password"
                        placeholder="Enter your password"
                    />
                </div>

                <!-- -----  Campo de recordarme  ----- -->
                <div class="flex items-center justify-between">
                    <div class="flex items-center">
                        <input
                            id="rememberMe"
                            name="remember_me"
                            type="checkbox"
                            checked={rememberMe}
                            class="h-4 w-4 bg-blue-500 focus:ring-blue-400 border-gray-300 rounded"
                        />

                        <label
                            for="rememberMe"
                            class="ml-2 block text-sm text-gray-800"
                        >
                            Recuerdame
                        </label>
                    </div>

                    <!-- -----  Enlace de registro  ----- -->
                    <div class="text-sm ml-10">
                        <a
                            href="/register"
                            class="text-green-400 hover:text-green-500"
                        >
                            ¿No tienes una cuenta? Regístrate
                        </a>
                    </div>
                </div>

                <!-- -----  Mensaje de resultado del formulario  ----- -->
                <p
                    id="formFeedback"
                    class="text-sm text-center min-h-5"
                    role="status"
                ></p>

                <!-- -----  Botón de envío del formulario  ----- -->
                <div class="flex flex-col gap-4">
                    <!--  -----  Botón para ingresar con correo electronico  -----  -->
                    <button
                        id="btnSubmit"
                        type="submit"
                        class="disabled:bg-gray-300 disabled:cursor-not-allowed w-full flex justify-center bg-green-400
                            hover:bg-green-500 text-gray-100 p-3
                            rounded-full tracking-wide font-semibold shadow-lg
                            cursor-pointer transition ease-in duration-500"
                    >
                        Ingresar
                    </button>

                    <!--  -----  Botón para ingresar con Google  -----  -->
                    <button
                        id="btnGoogle"
                        type="button"
                        class="disabled:bg-gray-300 disabled:cursor-not-allowed w-full flex justify-center bg-red-400
                            hover:bg-red-500 text-gray-100 p-3
                            rounded-full tracking-wide font-semibold shadow-lg
                            cursor-pointer transition ease-in duration-500"
                    >
                        Ingresar con Google
                    </button>
                </div>
            </div>

            <!-- -----  Pie de página del formulario  ----- -->
            <div class="pt-5 text-center text-gray-400 text-xs">
                <span>
                    Copyright © 2021-{new Date().getFullYear()}
                    <a
                        href="https://codepen.io/uidesignhub"
                        rel=""
                        target="_blank"
                        title="Ajimon"
                        class="text-green hover:text-green-500"
                    >
                        AJI
                    </a>
                </span>
            </div>
        </form>
    </div>
</AuthLayout>

<script>
    import { actions, isInputError } from "astro:actions";
    import Swal from "sweetalert2";
    import {
        GoogleAuthProvider,
        signInWithPopup,
        signOut,
        type AuthError,
    } from "firebase/auth";
    import { firebase } from "@/src/firebase/config";

    /**
     * ----------------------------------
     * -----  `prepareLoginForm()`  -----
     * ----------------------------------
     * - prepara el formulario de login en cada carga del router
     */
    const prepareLoginForm = (): void => {
        //*  -----  referencias al HTML  -----

        /** - `formulario de login` */
        const $form = document.querySelector("form") as HTMLFormElement | null;

        /** - `botón de envío` */
        const $btnSubmit = document.getElementById(
            "btnSubmit",
        ) as HTMLButtonElement | null;

        /** - `botón de ingreso con Google` */
        const $btnGoogle = document.getElementById(
            "btnGoogle",
        ) as HTMLButtonElement | null;

        /** - `mensaje de resultado del formulario` */
        const $formFeedback = document.getElementById(
            "formFeedback",
        ) as HTMLParagraphElement | null;

        /** - `checkbox de recordarme` */
        const $rememberMe = document.getElementById(
            "rememberMe",
        ) as HTMLInputElement | null;

        //*  -----  si el formulario está completo, escuchar el envío  -----
        if ($form && $btnSubmit && $btnGoogle && $formFeedback) {
            //*  -----  escuchar el envío del formulario  -----
            $form.addEventListener("submit", async (event) => {
                //  -----  evitar el envío nativo del formulario  -----
                event.preventDefault();

                //  -----  limpiar el mensaje anterior  -----
                $formFeedback.textContent = "";

                //  -----  desactivar el botón mientras se envía  -----
                $btnSubmit.setAttribute("disabled", "disabled");

                /** - `datos escritos en el formulario` */
                const formData = new FormData($form);

                /** - `resultado de la acción de login` */
                const { error } = await actions.loginUser(formData);

                //  -----  reactivar el botón al terminar  -----
                $btnSubmit.removeAttribute("disabled");

                //*  -----  si la acción devuelve un error, mostrarlo  -----
                if (error) {
                    /** - `mensajes de los campos inválidos` */
                    const fieldMessages = isInputError(error)
                        ? Object.values(error.fields)
                              .flat()
                              .filter((message): message is string =>
                                  Boolean(message),
                              )
                        : [];

                    /** - `mensaje del error del servidor (p. ej. correo duplicado)` */
                    const EMAIL_ALREADY_IN_USE =
                        "Correo electronico ya esta en uso";

                    /** - `verifica si el error es de correo duplicado` */
                    const isEmailInUse =
                        !isInputError(error) &&
                        error.message === EMAIL_ALREADY_IN_USE;

                    /** - `texto que verá el usuario en el modal` */
                    const swalText = isInputError(error)
                        ? fieldMessages.join(". ")
                        : isEmailInUse
                          ? EMAIL_ALREADY_IN_USE
                          : error.message;

                    /** - `título del modal según el tipo de error` */
                    const swalTitle = isEmailInUse
                        ? "¡Ups! Algo salió mal."
                        : isInputError(error)
                          ? "Revisá los datos del formulario"
                          : "¡Ups! Algo salió mal.";

                    //*  -----  mostrar el mensaje de error con sweetalert2  -----
                    Swal.fire({
                        title: swalTitle,
                        text: swalText,
                        icon: "error",
                        confirmButtonText: "OK",
                    });

                    //  -----  marcar el mensaje como error  -----
                    $formFeedback.classList.add("text-red-500");

                    //  -----  quitar el color de éxito  -----
                    $formFeedback.classList.remove("text-green-600");

                    //  -----  mostrar el error de validación o el de la acción  -----
                    $formFeedback.textContent = swalText;

                    //  -----  detener el envío  -----
                    return;
                }

                //  -----  marcar el mensaje como éxito  -----
                $formFeedback.classList.add("text-green-600");

                //  -----  quitar el color de error  -----
                $formFeedback.classList.remove("text-red-500");

                //  -----  confirmar el inicio de sesión  -----
                $formFeedback.textContent = "Sesión iniciada";

                //  -----  redirigir a la página protegida  -----
                window.location.replace("/protected");
            });

            //*  -----  escuchar el clic en ingresar con Google  -----
            $btnGoogle.addEventListener("click", async () => {
                //  -----  limpiar el mensaje anterior  -----
                $formFeedback.textContent = "";

                //  -----  desactivar los botones mientras se autentica  -----
                $btnGoogle.setAttribute("disabled", "disabled");
                $btnSubmit.setAttribute("disabled", "disabled");

                /** - `proveedor de autenticación de Google` */
                const googleProvider = new GoogleAuthProvider();

                // log  -----  googleProvider  -----
                console.log("\n\ngoogleProvider =>\n", googleProvider);
                // log  -----------------------------------------------

                try {
                    //  -----  abrir el popup de Google y completar el inicio de sesión  -----
                    const userCredential = await signInWithPopup(
                        firebase.auth,
                        googleProvider,
                    );

                    /** - `correo devuelto por Google` */
                    const googleEmail = userCredential.user.email;

                    //  -----  si Google no devolvió correo, cortar el flujo  -----
                    if (!googleEmail) {
                        await signOut(firebase.auth);

                        throw new Error(
                            "Google no devolvió un correo para esta cuenta.",
                        );
                    }

                    /** - `credencial OAuth del popup; no es el JWT de Firebase` */
                    const oauthCredential =
                        GoogleAuthProvider.credentialFromResult(userCredential);

                    //  -----  si Google no devolvió el id token OAuth, cortar el flujo  -----
                    if (!oauthCredential?.idToken) {
                        //  -----  cerrar la sesión local porque el token no sirve  -----
                        await signOut(firebase.auth);

                        //  -----  cortar el flujo  -----
                        throw new Error(
                            "Google no devolvió el token para validar la sesión.",
                        );
                    }

                    /** - `resultado de la acción loginGoogle en el servidor` */
                    const { error: googleActionError } =
                        await actions.loginGoogle({
                            idToken: oauthCredential.idToken,
                            accessToken:
                                oauthCredential.accessToken ?? undefined,
                            remember_me: $rememberMe?.checked ?? false,
                        });

                    //  -----  si la acción del servidor falla, cerrar sesión en el cliente  -----
                    if (googleActionError) {
                        await signOut(firebase.auth);

                        //*  -----  mostrar el mensaje de error con sweetalert2  -----
                        Swal.fire({
                            title: "¡Ups! Algo salió mal.",
                            text: googleActionError.message,
                            icon: "error",
                            confirmButtonText: "OK",
                        });

                        //  -----  marcar el mensaje como error  -----
                        $formFeedback.classList.add("text-red-500");
                        $formFeedback.classList.remove("text-green-600");
                        $formFeedback.textContent = googleActionError.message;

                        return;
                    }

                    //  -----  marcar el mensaje como éxito  -----
                    $formFeedback.classList.add("text-green-600");
                    $formFeedback.classList.remove("text-red-500");
                    $formFeedback.textContent = "Sesión iniciada con Google";

                    //  -----  redirigir a la página protegida  -----
                    window.location.replace("/protected");
                } catch (error) {
                    /** - `error tipado de Firebase` */
                    const firebaseError = error as AuthError;

                    /** - `mensaje amigable según el código de Firebase` */
                    const swalText =
                        firebaseError.code === "auth/popup-closed-by-user"
                            ? "Cancelaste el inicio de sesión con Google."
                            : firebaseError.code ===
                                "auth/cancelled-popup-request"
                              ? "Ya hay un inicio de sesión con Google en curso."
                              : error instanceof Error
                                ? error.message
                                : "No se pudo iniciar sesión con Google. Probá de nuevo.";

                    //*  -----  mostrar el mensaje de error con sweetalert2  -----
                    Swal.fire({
                        title: "¡Ups! Algo salió mal.",
                        text: swalText,
                        icon: "error",
                        confirmButtonText: "OK",
                    });

                    //  -----  marcar el mensaje como error  -----
                    $formFeedback.classList.add("text-red-500");
                    $formFeedback.classList.remove("text-green-600");
                    $formFeedback.textContent = swalText;
                } finally {
                    //  -----  reactivar los botones al terminar  -----
                    $btnGoogle.removeAttribute("disabled");
                    $btnSubmit.removeAttribute("disabled");
                }
            });
        }
    };

    //  -----  preparar el formulario en cada carga del router  -----
    document.addEventListener("astro:page-load", prepareLoginForm);
</script>
