---

/*
    *  ---------------------------------------------------------  *
    *  -----  Layout.astro  --  /src/layouts/Layout.astro  -----  *
    *  ---------------------------------------------------------  *
 */

import { ClientRouter } from "astro:transitions";
import "@/src/styles/global.css";
import Navbar from "@/src/components/shared/Navbar.astro";



interface Props {

    title?: string;
}



const { title = "06 - Auth Astro App" } = Astro.props;

---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/astro-auth.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <ClientRouter />
    </head>

    <body>
        <Navbar />

        <main class="container mx-auto max-w-3xl px-4 py-8">
            <slot />
        </main>
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
