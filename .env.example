
# Firebase Web API key (client; restrict by domain in Firebase Console).
PUBLIC_FIREBASE_API_KEY=your-firebase-api-key

# Authorized domain for Firebase Authentication (email/password, OAuth redirects).
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Firebase/GCP project identifier.
PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Default Cloud Storage bucket for this project.
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# FCM sender ID for push notifications (numeric).
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Unique Firebase web app instance ID in this project.
PUBLIC_FIREBASE_APP_ID=your-app-id

# Google Analytics 4 measurement ID (optional; Analytics).
PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id