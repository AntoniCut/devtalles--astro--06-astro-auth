{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "paths": {
            "@/*": ["./*"]
        }
    },
    "include": [".astro/types.d.ts", "**/*", "types/**/*.ts"],
    "exclude": ["dist", "node_modules"]
}
